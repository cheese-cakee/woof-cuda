--- a/ggml/src/ggml-quants.c
+++ b/ggml/src/ggml-quants.c
@@ -25,6 +25,44 @@
 
 #define UNUSED GGML_UNUSED
 
+
+void quantize_row_q4_64_ref(const float * x, block_q4_64 * y, int64_t k) {
+    assert(k % QK4_64 == 0);
+    for (int64_t i = 0; i < k / QK4_64; ++i) {
+        float minimum = x[i*64];
+        float maximum = minimum;
+        for (int j = 1; j < 64; ++j) {
+            minimum = fminf(minimum, x[i*64 + j]);
+            maximum = fmaxf(maximum, x[i*64 + j]);
+        }
+        const float scale = (maximum - minimum) / 15;
+        const float inverse = scale == 0 ? 0 : 1 / scale;
+        y[i].d = GGML_FP32_TO_FP16(scale);
+        y[i].m = GGML_FP32_TO_FP16(minimum);
+        for (int half = 0; half < 2; ++half) {
+            for (int j = 0; j < 16; ++j) {
+                const int first = (int) fminf(15, fmaxf(0, roundf((x[i*64 + half*32 + j] - minimum)*inverse)));
+                const int second = (int) fminf(15, fmaxf(0, roundf((x[i*64 + half*32 + j + 16] - minimum)*inverse)));
+                y[i].qs[half*16 + j] = first | (second << 4);
+            }
+        }
+    }
+}
+
+void dequantize_row_q4_64(const block_q4_64 * x, float * y, int64_t k) {
+    assert(k % QK4_64 == 0);
+    for (int64_t i = 0; i < k / QK4_64; ++i) {
+        const float scale = GGML_FP16_TO_FP32(x[i].d);
+        const float bias = GGML_FP16_TO_FP32(x[i].m);
+        for (int half = 0; half < 2; ++half) {
+            for (int j = 0; j < 16; ++j) {
+                y[i*64 + half*32 + j] = scale*(x[i].qs[half*16 + j] & 15) + bias;
+                y[i*64 + half*32 + j + 16] = scale*(x[i].qs[half*16 + j] >> 4) + bias;
+            }
+        }
+    }
+}
